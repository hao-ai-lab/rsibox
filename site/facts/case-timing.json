       "-        with quant_context:",
       "-            out = super().forward(x, is_first_microbatch=_is_first_microbatch)",
       "+        gather_before_norm = (",
       "+            self.training",
       "+            and torch.is_grad_enabled()",
       "+            and self.sequence_parallel",
       "+            and self.tp_size > 1",
       "+            and self.parallel_mode == \"column\"",
       "+            and self.te_quant_params is None",

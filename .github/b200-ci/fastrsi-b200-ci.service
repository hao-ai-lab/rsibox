# systemd user unit for the B200 CI loop. NOT installed or enabled.
# To install (owner decision; it posts statuses only if you add --post):
#   mkdir -p ~/.config/systemd/user ~/fastrsi-ci/runner
#   cp -r <trusted main checkout>/.github/b200-ci/* ~/fastrsi-ci/runner/
#   cp ~/fastrsi-ci/runner/fastrsi-b200-ci.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now fastrsi-b200-ci
# The runner code comes from ~/fastrsi-ci/runner (a copy you trust), never from the commit under test.
[Unit]
Description=FastRSI B200 CI loop (b200-gpu commit status)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/fastrsi-ci/runner/b200_ci_loop.py --work %h/fastrsi-ci --gpus auto:2 --vllm-python /usr/bin/python3 --interval 300
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target

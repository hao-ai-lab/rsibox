+def _h3_gated_merge_kernel():
+    """Return the fused BHSD->BSHD transpose + gated compression merge kernel.
+
+    Built once on first use and cached on this function. ``triton`` and
+    ``triton.language`` are bound as module globals here (not locals) so the
+    kernel body resolves them as globals, which is what Triton expects.
+    """
+    kernel = getattr(_h3_gated_merge_kernel, "kernel", None)
+    if kernel is None:
+        g = globals()
+        if "_h3_tl" not in g:
+            g["_h3_triton"] = __import__("triton")
+            g["_h3_tl"] = __import__("triton.language").language
+
+        @g["_h3_triton"].jit
+        def _kernel(
+            out_ptr,
+            o_ptr,
+            c_ptr,
+            g_ptr,
+            seq_len,
+            heads,
+            tile_elems,
+            o_sb, o_sh, o_ss,
+            c_sb, c_st, c_sh,
+            g_sb, g_ss, g_sh,
+            BLOCK_S: _h3_tl.constexpr,
+            HEAD_DIM: _h3_tl.constexpr,
+        ):
+            # out[b, s, h, :] = o[b, h, s, :] + c[b, s // tile, h, :] * g[b, s, h, :]
+            # bf16*bf16 is exact in fp32, so this matches addcmul_ (one fp32 add,
+            # one RTNE round to bf16) bit for bit.
+            bh = _h3_tl.program_id(0)
+            b = bh // heads
+            h = bh % heads
+            s = _h3_tl.program_id(1).to(_h3_tl.int64) * BLOCK_S + _h3_tl.arange(0, BLOCK_S).to(_h3_tl.int64)
+            d = _h3_tl.arange(0, HEAD_DIM)
+            smask = (s < seq_len)[:, None]
+            t = s // tile_elems
+            o = _h3_tl.load(o_ptr + b * o_sb + h * o_sh + s[:, None] * o_ss + d[None, :], mask=smask,
+                            other=0.0).to(_h3_tl.float32)
+            gv = _h3_tl.load(g_ptr + b * g_sb + h * g_sh + s[:, None] * g_ss + d[None, :], mask=smask,
+                             other=0.0).to(_h3_tl.float32)
+            cv = _h3_tl.load(c_ptr + b * c_sb + h * c_sh + t[:, None] * c_st + d[None, :], mask=smask,
+                             other=0.0).to(_h3_tl.float32)
+            res = o + cv * gv
+            _h3_tl.store(out_ptr + ((b * seq_len + s[:, None]) * heads + h) * HEAD_DIM + d[None, :],
+                         res.to(out_ptr.dtype.element_ty), mask=smask)
+
+        kernel = _kernel
+        _h3_gated_merge_kernel.kernel = kernel
+    return kernel
+
+
+def _h3_gated_merge(out_bshd_view: torch.Tensor, out_c: torch.Tensor, gate: torch.Tensor,
+                    tile_elems: int) -> torch.Tensor:
+    """Contiguous ``out_bshd_view + out_c (broadcast per tile) * gate`` in one pass.
+
+    out_bshd_view: [B, S, H, D] (any strides, last dim contiguous);
+    out_c: [B, n_tiles, H, D]; gate: [B, S, H, D]. Returns a new contiguous
+    [B, S, H, D] tensor equal to ``out_bshd_view.contiguous()`` followed by
+    the tiled ``addcmul_``.
+    """
+    batch, seq_len, heads, dim = out_bshd_view.shape
+    result = torch.empty((batch, seq_len, heads, dim), dtype=out_bshd_view.dtype, device=out_bshd_view.device)
+    block_s = 32
+    grid = (batch * heads, (seq_len + block_s - 1) // block_s)
+    _h3_gated_merge_kernel()[grid](
+        result,
+        out_bshd_view,
+        out_c,
+        gate,
+        seq_len,
+        heads,
+        tile_elems,
+        out_bshd_view.stride(0), out_bshd_view.stride(2), out_bshd_view.stride(1),
+        out_c.stride(0), out_c.stride(1), out_c.stride(2),
+        gate.stride(0), gate.stride(1), gate.stride(2),
+        BLOCK_S=block_s,
+        HEAD_DIM=dim,
+        num_warps=4,
+    )
+    return result
+

+                graph = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(graph, stream=side):
+                    static_outputs = _h3_projection_graph_ops(
+                        attn, static_input, static_rotary,
+                    )
+
+                after_capture = _h3_projection_graph_signature(
+                    attn, hidden_states, rotary_emb, current,

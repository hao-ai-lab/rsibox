+    with torch.cuda.device(hidden_states.device):
+        if torch.cuda.is_current_stream_capturing():
+            return None
+        current = torch.cuda.current_stream(hidden_states.device)
+        signature = _h3_projection_graph_signature(
+            attn, hidden_states, rotary_emb, current,
+        )
+        if signature is None:
+            return None
+
+        cache = getattr(_h3_projection_graph_forward, "_projection_graphs_v1", None)
+        if cache is None:
+            import weakref
+            cache = weakref.WeakKeyDictionary()

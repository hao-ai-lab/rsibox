+            or hidden_states.requires_grad
+            or not hidden_states.is_cuda
+            or hidden_states.dtype != torch.bfloat16
+            or hidden_states.ndim != 3
+            or hidden_states.shape[0] != 1
+            or hidden_states.shape[1] < 1024
+            or hidden_states.shape[2] <= 0
+            or not hidden_states.is_contiguous()
+            or hidden_states.storage_offset() != 0
+            or rotary_emb is None
+            or len(rotary_emb) != 2
+            or torch.cuda.get_device_capability(hidden_states.device) != (10, 0)):
+        return None
+
+    if model_parallel_is_initialized() and get_sp_world_size() not in (1, 2):
+        return None
+    cos, sin = rotary_emb
+    if (cos.shape != sin.shape
+            or cos.ndim != 2
+            or cos.shape[0] != hidden_states.shape[1]
+            or not 0 < cos.shape[1] <= 128
+            or cos.shape[1] % 2):
+        return None
+    for tensor in rotary_emb:
+        if (tensor.device != hidden_states.device

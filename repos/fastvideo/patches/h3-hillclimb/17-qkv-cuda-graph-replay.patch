+        state = cache.get(attn)
+        if state is None or state[0] != signature:
+            cache.pop(attn, None)
+            static_input = torch.empty_like(hidden_states)
+            static_rotary = (torch.empty_like(cos), torch.empty_like(sin))
+            side = torch.cuda.Stream(device=hidden_states.device)
+            side.wait_stream(current)
+            try:
+                with torch.cuda.stream(side):
+                    static_input.copy_(hidden_states)
+                    static_rotary[0].copy_(cos)
+                    static_rotary[1].copy_(sin)
+                    for _ in range(2):

+def _h3_projection_graph_signature(attn, hidden_states, rotary_emb, stream):
+    """Track projection weights, quantization policy, layouts, and execution state."""
+    tensors = []
+    options = []
+    for name in ("to_q", "to_k", "to_v", "to_gate_compress"):
+        module = getattr(attn, name)
+        if (type(module) is not ReplicatedLinear
+                or module.training
+                or module.bias is not None
+                or "forward" in vars(module)
+                or getattr(module, "_compiled_call_impl", None) is not None
+                or module._forward_hooks
+                or module._forward_pre_hooks
+                or module._backward_hooks
+                or module._backward_pre_hooks):
+            return None
+        method = module.quant_method
+        if type(method).__name__ != "NVFP4QuantizeMethod":
+            return None
+        packed = getattr(module, "_nvfp4_weight", None)
+        if (not isinstance(packed, torch.Tensor)
+                or packed.device != hidden_states.device):
+            return None
+        owners = (
+            ("module", vars(module)),
+            ("parameters", module._parameters),
+            ("buffers", module._buffers),
+            ("method", vars(method)),
+        )
+        for owner_name, values in owners:
+            for attr, value in sorted(values.items()):
+                label = (name, owner_name, attr)
+                if isinstance(value, torch.Tensor):
+                    try:
+                        version = value._version
+                    except RuntimeError:
+                        return None
+                    tensors.append((
+                        label, id(value), value.data_ptr(), version,
+                        tuple(value.shape), tuple(value.stride()),
+                        value.dtype, value.device,
+                    ))
+                elif type(value) in (bool, int, float, str, type(None)):
+                    options.append((label, value))
+        options.append((
+            name, id(module), id(method), type(method),
+            type(module).forward, getattr(type(method), "apply", None),
+        ))
+
+    for name in ("norm_q", "norm_k"):
+        norm = getattr(attn, name)
+        if (type(norm) is not nn.RMSNorm
+                or norm.training
+                or norm.weight is None
+                or norm.weight.device != hidden_states.device
+                or norm.weight.shape != (128,)):
+            return None
+        weight = norm.weight
+        try:
+            version = weight._version
+        except RuntimeError:
+            return None
+        tensors.append((
+            name, id(weight), weight.data_ptr(), version,
+            tuple(weight.shape), tuple(weight.stride()),
+            weight.dtype, weight.device,
+        ))
+        options.append((name, norm.eps))
+
+    return (
+        tuple(hidden_states.shape),
+        tuple(hidden_states.stride()),
+        hidden_states.dtype,
+        hidden_states.device,
+        tuple(
+            (tuple(t.shape), tuple(t.stride()), t.dtype, t.device)
+            for t in rotary_emb
+        ),
+        stream.cuda_stream,
+        torch.is_inference_mode_enabled(),
+        torch.is_autocast_enabled("cuda"),
+        torch.get_autocast_dtype("cuda"),
+        attn.num_attention_heads,
+        attn.attention_head_dim,
+        attn.fuse_qknorm_rope,
+        _h3_projection_graph_ops,
+        tuple(tensors),
+        tuple(options),
+    )
+

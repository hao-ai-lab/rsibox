+def _h3_projection_graph_forward(attn, hidden_states, rotary_emb):
+    """Borrow projection graph outputs until this layer's next dispatch."""
+    if (torch.compiler.is_compiling()
+            or torch.is_grad_enabled()
+            or type(attn) is not MiniMaxH3Attention
+            or attn.training

+def _h3_projection_graph_ops(attn, hidden_states, rotary_emb):
+    """The existing fused projection path, with identical operation order."""
+    from fastvideo.models.dits.minimax_h3_vsa_fp4 import _shared_input_projections
+
+    query, key, value = _shared_input_projections(
+        (attn.to_q, attn.to_k, attn.to_v), hidden_states,
+    )
+    query = query.unflatten(
+        -1, (attn.num_attention_heads, attn.attention_head_dim),
+    )
+    key = key.unflatten(
+        -1, (attn.num_attention_heads, attn.attention_head_dim),
+    )
+    value = value.unflatten(
+        -1, (attn.num_attention_heads, attn.attention_head_dim),
+    )
+    cos, sin = rotary_emb
+    cos = cos.to(query.dtype)
+    sin = sin.to(query.dtype)
+    query = fused_qknorm_rope(
+        query, attn.norm_q.weight, cos, sin, attn.norm_q.eps,
+    )
+    key = fused_qknorm_rope(
+        key, attn.norm_k.weight, cos, sin, attn.norm_k.eps,
+    )
+    gate, _ = attn.to_gate_compress(hidden_states)
+    gate = gate.unflatten(
+        -1, (attn.num_attention_heads, attn.attention_head_dim),
+    )
+    return query, key, value, gate

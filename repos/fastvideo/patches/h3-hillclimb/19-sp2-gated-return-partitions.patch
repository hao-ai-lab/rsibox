+def _h3_sp2_flat_return_kernels():
+    """Build and cache the contiguous-segment return kernels on dispatch."""
+    kernels = getattr(_h3_sp2_flat_return_kernels, "_kernels_v37", None)
+    if kernels is None:
+        g = globals()
+        g["_h3_ret37_triton"] = __import__("triton")
+        g["_h3_ret37_tl"] = __import__("triton.language").language
+
+        @g["_h3_ret37_triton"].jit
+        def merge_local_and_send(
+            Send, Result, Out, Compress, Gate, Slots,
+            O_H, O_S, C_T, C_H, G_S, G_H,
+            S: _h3_ret37_tl.constexpr,
+            P: _h3_ret37_tl.constexpr,
+            H: _h3_ret37_tl.constexpr,
+            RANK: _h3_ret37_tl.constexpr,
+            BLOCK: _h3_ret37_tl.constexpr,
+        ):
+            x = (
+                _h3_ret37_tl.program_id(0).to(_h3_ret37_tl.int64) * BLOCK
+                + _h3_ret37_tl.arange(0, BLOCK)
+            )
+            dest = _h3_ret37_tl.program_id(1)
+            local_s = x // (H * 128)
+            h = (x // 128) % H
+            d = x % 128
+            p = dest * S + local_s
+            transport_valid = x < S * H * 128
+            valid = transport_valid & (p < P)
+            slot = _h3_ret37_tl.load(
+                Slots + p, mask=valid, other=0,
+            ).to(_h3_ret37_tl.int64)
+            o = _h3_ret37_tl.load(
+                Out + h * O_H + slot * O_S + d,
+                mask=valid, other=0.0,
+            ).to(_h3_ret37_tl.float32)
+            gv = _h3_ret37_tl.load(
+                Gate + h * G_H + slot * G_S + d,
+                mask=valid, other=0.0,
+            ).to(_h3_ret37_tl.float32)
+            cv = _h3_ret37_tl.load(
+                Compress + h * C_H + (slot // 64) * C_T + d,
+                mask=valid, other=0.0,
+            ).to(_h3_ret37_tl.float32)
+            res = o + cv * gv
+            res = _h3_ret37_tl.where(valid, res, 0.0)
+            rounded = res.to(Send.dtype.element_ty)
+            if dest == RANK:
+                dst = (
+                    local_s * (2 * H * 128)
+                    + RANK * H * 128 + h * 128 + d
+                )
+                _h3_ret37_tl.store(
+                    Result + dst, rounded, mask=transport_valid,
+                )
+            else:
+                _h3_ret37_tl.store(
+                    Send + x, rounded, mask=transport_valid,
+                )
+
+        @g["_h3_ret37_triton"].jit
+        def unpack_remote(
+            Recv, Result,
+            S: _h3_ret37_tl.constexpr,
+            H: _h3_ret37_tl.constexpr,
+            RANK: _h3_ret37_tl.constexpr,
+            BLOCK: _h3_ret37_tl.constexpr,
+        ):
+            x = (
+                _h3_ret37_tl.program_id(0).to(_h3_ret37_tl.int64) * BLOCK
+                + _h3_ret37_tl.arange(0, BLOCK)
+            )
+            valid = x < S * H * 128
+            s = x // (H * 128)
+            hd = x % (H * 128)
+            dst = s * (2 * H * 128) + (1 - RANK) * H * 128 + hd
+            bits = _h3_ret37_tl.load(Recv + x, mask=valid, other=0)
+            _h3_ret37_tl.store(Result + dst, bits, mask=valid)
+
+        kernels = (merge_local_and_send, unpack_remote)
+        _h3_sp2_flat_return_kernels._kernels_v37 = kernels
+    return kernels

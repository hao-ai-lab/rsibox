+def _qknorm_partial_rope_rows_kernel():
+    """Return the ROWS-heads-per-program variant of ``_qknorm_partial_rope_kernel``.
+
+    Built once on first use and cached on this function.
+    """
+    kernel = getattr(_qknorm_partial_rope_rows_kernel, "kernel", None)
+    if kernel is None:
+
+        @triton.jit
+        def _kernel(
+            out_ptr,
+            x_ptr,
+            weight_ptr,
+            cos_ptr,
+            sin_ptr,
+            n_rows,
+            rotary_dim,
+            half_rotary_dim,
+            num_heads,
+            seq_len,
+            eps,
+            HEAD_DIM: tl.constexpr,
+            ROWS: tl.constexpr,
+        ):
+            # ROWS heads per program (``_qknorm_partial_rope_kernel`` runs one).
+            # The RMS reduction is an explicit pairwise tree that reproduces the
+            # single-row kernel's 4-warp tl.sum order bit for bit: lane butterfly
+            # xor 16,8,4,2,1 inside each 32-column warp slice, then
+            # (w0 + w2) + (w1 + w3) across the four slices.
+            rows = tl.program_id(0).to(tl.int64) * ROWS + tl.arange(0, ROWS).to(tl.int64)
+            row_mask = rows < n_rows
+            seq_index = (rows // num_heads) % seq_len
+            cols = tl.arange(0, HEAD_DIM)
+            offs = rows[:, None] * HEAD_DIM + cols[None, :]
+            mask2 = row_mask[:, None]
+            x = tl.load(x_ptr + offs, mask=mask2, other=0.0).to(tl.float32)
+            sq = x * x
+            s = tl.reshape(sq, (ROWS, 4, 2, 16))
+            s = tl.sum(s, axis=2)
+            s = tl.reshape(s, (ROWS, 4, 2, 8))
+            s = tl.sum(s, axis=2)
+            s = tl.reshape(s, (ROWS, 4, 2, 4))
+            s = tl.sum(s, axis=2)
+            s = tl.reshape(s, (ROWS, 4, 2, 2))
+            s = tl.sum(s, axis=2)
+            s = tl.reshape(s, (ROWS, 4, 2, 1))
+            s = tl.sum(s, axis=2)
+            s = tl.reshape(s, (ROWS, 2, 2))  # [w0 w1; w2 w3]
+            s = tl.sum(s, axis=1)  # (w0 + w2), (w1 + w3)
+            s = tl.sum(s, axis=1)
+            variance = s / HEAD_DIM
+            inv_rms = tl.math.rsqrt(variance + eps)
+            weight = tl.load(weight_ptr + cols).to(tl.float32)
+            normalized = x * inv_rms[:, None] * weight[None, :]
+
+            rotary_mask = cols < rotary_dim
+            first_half = cols < half_rotary_dim
+            partner_col = tl.where(first_half, cols + half_rotary_dim, cols - half_rotary_dim)
+            pmask = mask2 & rotary_mask[None, :]
+            partner_x = tl.load(
+                x_ptr + rows[:, None] * HEAD_DIM + partner_col[None, :],
+                mask=pmask,
+                other=0.0,
+            ).to(tl.float32)
+            partner_weight = tl.load(weight_ptr + partner_col, mask=rotary_mask, other=0.0).to(tl.float32)
+            partner_normalized = partner_x * inv_rms[:, None] * partner_weight[None, :]
+            rotated = tl.where(first_half[None, :], -partner_normalized, partner_normalized)
+
+            table_offset = seq_index[:, None] * rotary_dim + cols[None, :]
+            cos = tl.load(cos_ptr + table_offset, mask=pmask, other=1.0).to(tl.float32)
+            sin = tl.load(sin_ptr + table_offset, mask=pmask, other=0.0).to(tl.float32)
+            rotary_output = normalized * cos + rotated * sin
+            output = tl.where(rotary_mask[None, :], rotary_output, normalized)
+            tl.store(out_ptr + offs, output.to(out_ptr.dtype.element_ty), mask=mask2)
+
+        kernel = _kernel
+        _qknorm_partial_rope_rows_kernel.kernel = kernel
+    return kernel

+def _h3_direct_gate_merge_kernel():
+    """Existing packed merge arithmetic, reading the original packed gate."""
+    kernel = getattr(_h3_direct_gate_merge_kernel, "kernel", None)
+    if kernel is None:
+        g = globals()
+        if "_h3_tl" not in g:
+            g["_h3_triton"] = __import__("triton")
+            g["_h3_tl"] = __import__("triton.language").language
+
+        @g["_h3_triton"].jit
+        def _kernel(
+            result_ptr, out_ptr, compress_ptr, gate_ptr, slots_ptr,
+            packed_len, heads,
+            o_sb, o_sh, o_ss,
+            c_sb, c_st, c_sh,
+            g_sb, g_ss, g_sh,
+            BLOCK_S: _h3_tl.constexpr,
+            HEAD_DIM: _h3_tl.constexpr,
+        ):
+            bh = _h3_tl.program_id(0)
+            b = bh // heads
+            h = bh % heads
+            p = (_h3_tl.program_id(1).to(_h3_tl.int64) * BLOCK_S
+                 + _h3_tl.arange(0, BLOCK_S).to(_h3_tl.int64))
+            d = _h3_tl.arange(0, HEAD_DIM)
+            valid = p < packed_len
+            s = _h3_tl.load(slots_ptr + p, mask=valid, other=0).to(_h3_tl.int64)
+            t = s // 64
+            o = _h3_tl.load(
+                out_ptr + b * o_sb + h * o_sh + s[:, None] * o_ss + d[None, :],
+                mask=valid[:, None], other=0.0,
+            ).to(_h3_tl.float32)
+            gv = _h3_tl.load(
+                gate_ptr + b * g_sb + h * g_sh + p[:, None] * g_ss + d[None, :],
+                mask=valid[:, None], other=0.0,
+            ).to(_h3_tl.float32)
+            cv = _h3_tl.load(
+                compress_ptr + b * c_sb + h * c_sh + t[:, None] * c_st + d[None, :],
+                mask=valid[:, None], other=0.0,
+            ).to(_h3_tl.float32)
+            res = o + cv * gv
+            _h3_tl.store(
+                result_ptr + ((b * packed_len + p[:, None]) * heads + h) * HEAD_DIM + d[None, :],
+                res.to(result_ptr.dtype.element_ty),
+                mask=valid[:, None],
+            )
+
+        kernel = _kernel
+        _h3_direct_gate_merge_kernel.kernel = kernel
+    return kernel

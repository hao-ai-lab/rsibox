+def _h3_forward_packed(impl, query, key, value, gate, metadata):
+    """Return fused packed output for eligible inference, otherwise None."""
+    if (torch.compiler.is_compiling() or torch.is_grad_enabled()
+            or type(impl) is not MiniMaxH3VSAImpl
+            or type(metadata) is not MiniMaxH3VSAMetadata
+            or metadata.tile_elems != 64
+            or gate is None
+            or impl.fine_attention_override is not None
+            or impl._sm89_kernel != "original"
+            or block_sparse_attn_64_bhsd is None
+            or envs.FASTVIDEO_VSA_PTX_BLACKWELL.get()):
+        return None
+    if probe_enabled() is not None:
+        return None
+    from fastvideo.distributed.parallel_state import get_sp_world_size
+    if get_sp_world_size() != 1:
+        return None
+    if (query.ndim != 4 or not query.is_cuda
+            or query.dtype != torch.bfloat16 or query.shape[-1] != 128
+            or torch.cuda.get_device_capability(query.device) != (10, 0)):
+        return None
+    sizes = metadata.variable_block_sizes
+    n_tiles = sizes.numel()
+    if n_tiles == 0 or query.shape[1] != n_tiles * 64:
+        return None
+    for tensor in (query, key, value, gate):
+        if (tensor.shape != query.shape or tensor.device != query.device
+                or tensor.dtype != query.dtype or tensor.requires_grad
+                or tensor.stride(-1) != 1):
+            return None
+    slots = metadata.untile_combined_index
+    if (slots.device != query.device or slots.dtype != torch.int64
+            or slots.ndim != 1 or not slots.is_contiguous()
+            or slots.numel() != metadata.total_seq_length
+            or slots.numel() == 0 or query.shape[0] == 0 or query.shape[2] == 0
+            or sizes.device != query.device or sizes.ndim != 1
+            or sizes.dtype not in (torch.int32, torch.int64)):
+        return None
+
+    layer_sparsity = 0.0 if impl.layer_idx in metadata.dense_layers else metadata.VSA_sparsity
+    q_pooled = _pool_tiles(query, sizes, 64)
+    k_pooled = _pool_tiles(key, sizes, 64)
+    scores = torch.matmul(q_pooled, k_pooled.transpose(-2, -1)) / (query.shape[-1]**0.5)
+    mask = _build_block_mask(
+        scores, metadata.num_prefix_tiles, layer_sparsity, metadata.exempt,
+        metadata.video_tile_spans, metadata.span_sparsities,
+    )
+    out_bhsd, _ = _h3_block_sparse_attn_64(
+        query.transpose(1, 2).contiguous(),
+        key.transpose(1, 2).contiguous(),
+        value.transpose(1, 2).contiguous(),
+        mask, sizes,
+    )
+    v_pooled = _pool_tiles(value, sizes, 64)
+    out_c = torch.matmul(torch.softmax(scores, dim=-1), v_pooled)
+    out_c = out_c.permute(0, 2, 1, 3).to(out_bhsd.dtype)
+
+    batch, _, heads, dim = query.shape
+    packed_len = slots.numel()
+    result = torch.empty(
+        (batch, packed_len, heads, dim), dtype=query.dtype, device=query.device,
+    )
+    _h3_packed_gated_merge_kernel()[(batch * heads, (packed_len + 31) // 32)](
+        result, out_bhsd, out_c, gate, slots,
+        packed_len, heads,
+        out_bhsd.stride(0), out_bhsd.stride(1), out_bhsd.stride(2),
+        out_c.stride(0), out_c.stride(1), out_c.stride(2),
+        gate.stride(0), gate.stride(1), gate.stride(2),
+        BLOCK_S=32, HEAD_DIM=dim, num_warps=4,
+    )
+    return result

+def _h3_sp2_transport_tile(impl, xs, metadata, original_seq_len):
+    """Pack SP=2 sends and scatter receives directly into the tile buffer."""
+    if (torch.compiler.is_compiling() or torch.is_grad_enabled()
+            or type(impl) is not MiniMaxH3VSAImpl
+            or type(metadata) is not MiniMaxH3VSAMetadata
+            or metadata.tile_elems != 64
+            or envs.FASTVIDEO_VSA_PTX_BLACKWELL.get()
+            or len(xs) not in (3, 4)):
+        return None
+
+    import torch.distributed as dist
+    from fastvideo.distributed.parallel_state import get_sp_group, get_sp_world_size
+
+    if not dist.is_initialized() or get_sp_world_size() != 2:
+        return None
+    group = getattr(get_sp_group(), "device_group", None)
+    if (not isinstance(group, dist.ProcessGroup)
+            or dist.get_world_size(group) != 2
+            or dist.get_backend(group) != "nccl"):
+        return None
+
+    x = xs[0]
+    if (x.ndim != 4 or x.shape[0] != 1 or not x.is_cuda
+            or x.dtype != torch.bfloat16 or x.shape[-1] != 128
+            or x.shape[1] <= 0 or x.shape[2] <= 0 or x.shape[2] % 2
+            or torch.cuda.get_device_capability(x.device) != (10, 0)):
+        return None
+    if any(t.shape != x.shape or t.device != x.device or t.dtype != x.dtype
+           or not t.is_contiguous() or t.requires_grad for t in xs):
+        return None
+
+    slots = metadata.untile_combined_index
+    sizes = metadata.variable_block_sizes
+    holder = metadata.tile_buf_holder
+    if (holder is None or original_seq_len != metadata.total_seq_length
+            or not 0 < original_seq_len <= 2 * x.shape[1]
+            or slots.device != x.device or slots.dtype != torch.int64
+            or slots.ndim != 1 or not slots.is_contiguous()
+            or slots.numel() != original_seq_len
+            or sizes.device != x.device or sizes.ndim != 1
+            or sizes.dtype not in (torch.int32, torch.int64)
+            or sizes.numel() == 0):
+        return None
+
+    n = len(xs)
+    s, heads = x.shape[1:3]
+    half = heads // 2
+    tiled_len = sizes.numel() * 64
+    send = torch.empty((2, n, s, half, 128), dtype=x.dtype, device=x.device)
+    recv = torch.empty_like(send)
+
+    # Check the ordinary post-collective layout, whose sequence is global.
+    # Local inputs have only s rows and cannot be checked against global slots.
+    layout_probe = recv.view(n, 2 * s, half, 128)[:, :original_seq_len]
+    if not supports_heads_first_scatter(layout_probe, slots):
+        return None
+
+    kernels = getattr(_h3_sp2_transport_tile, "kernels", None)
+    if kernels is None:
+        g = globals()
+        g["_h3_sp_triton"] = __import__("triton")
+        g["_h3_sp_tl"] = __import__("triton.language").language
+
+        @g["_h3_sp_triton"].jit
+        def pack(
+            Q, K, V, G, Send,
+            S: _h3_sp_tl.constexpr,
+            H: _h3_sp_tl.constexpr,
+            N: _h3_sp_tl.constexpr,
+            BLOCK: _h3_sp_tl.constexpr,
+        ):
+            x = (_h3_sp_tl.program_id(0).to(_h3_sp_tl.int64) * BLOCK
+                 + _h3_sp_tl.arange(0, BLOCK))
+            member = _h3_sp_tl.program_id(1)
+            dest = _h3_sp_tl.program_id(2)
+            half = H // 2
+            valid = x < S * half * 128
+            d = x % 128
+            h = (x // 128) % half
+            s = x // (half * 128)
+            src = (s * H + dest * half + h) * 128 + d
+            if member == 0:
+                value = _h3_sp_tl.load(Q + src, valid, other=0)
+            elif member == 1:
+                value = _h3_sp_tl.load(K + src, valid, other=0)
+            elif member == 2:
+                value = _h3_sp_tl.load(V + src, valid, other=0)
+            else:
+                value = _h3_sp_tl.load(G + src, valid, other=0)
+            dst = (dest * N + member) * S * half * 128 + x
+            _h3_sp_tl.store(Send + dst, value, valid)
+
+        @g["_h3_sp_triton"].jit
+        def tile_received(
+            Recv, Slots, Out,
+            S: _h3_sp_tl.constexpr,
+            H: _h3_sp_tl.constexpr,
+            N: _h3_sp_tl.constexpr,
+            P: _h3_sp_tl.constexpr,
+            T: _h3_sp_tl.constexpr,
+            BLOCK: _h3_sp_tl.constexpr,
+        ):
+            x = (_h3_sp_tl.program_id(0).to(_h3_sp_tl.int64) * BLOCK
+                 + _h3_sp_tl.arange(0, BLOCK))
+            h = _h3_sp_tl.program_id(1)
+            member = _h3_sp_tl.program_id(2)
+            p = x // 128
+            d = x % 128
+            valid = p < P
+            slot = _h3_sp_tl.load(Slots + p, valid, other=0).to(_h3_sp_tl.int64)
+            source_rank = p // S
+            local_s = p % S
+            src = (((source_rank * N + member) * S + local_s) * H + h) * 128 + d
+            value = _h3_sp_tl.load(Recv + src, valid, other=0)
+            dst = ((member * H + h) * T + slot) * 128 + d
+            _h3_sp_tl.store(Out + dst, value, valid)
+
+        kernels = (pack, tile_received)
+        _h3_sp2_transport_tile.kernels = kernels
+
+    shape = (n, half, tiled_len, 128)
+    buffer = holder.heads_first_buffer
+    if (buffer is None or buffer.shape != shape or buffer.dtype != x.dtype
+            or buffer.device != x.device or not buffer.is_contiguous()):
+        buffer = torch.zeros(shape, dtype=x.dtype, device=x.device)
+    elif holder.heads_first_geometry is not slots:
+        buffer.zero_()
+
+    # Integer views make both custom kernels pure 16-bit copies.
+    bits = [t.view(torch.int16) for t in xs]
+    pack, tile_received = kernels
+    pack[((s * half * 128 + 511) // 512, n, 2)](
+        bits[0], bits[1], bits[2], bits[3] if n == 4 else bits[0],
+        send.view(torch.int16),
+        S=s, H=heads, N=n, BLOCK=512, num_warps=4,
+    )
+    dist.all_to_all_single(recv, send, group=group)
+    tile_received[((original_seq_len * 128 + 511) // 512, half, n)](
+        recv.view(torch.int16), slots, buffer.view(torch.int16),
+        S=s, H=half, N=n, P=original_seq_len, T=tiled_len,
+        BLOCK=512, num_warps=4,
+    )
+    holder.heads_first_buffer = buffer
+    holder.heads_first_geometry = slots
+    return buffer.transpose(1, 2)
+
+

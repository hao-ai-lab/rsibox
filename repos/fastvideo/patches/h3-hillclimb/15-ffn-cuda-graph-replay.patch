+def _h3_ff_graph_forward(ff, hidden_states):
+    """Replay the original inference FFN, or return None for eager fallback."""
+    if (torch.compiler.is_compiling()
+            or torch.is_grad_enabled()
+            or type(ff) is not MiniMaxH3FeedForward
+            or ff.training
+            or ff.use_mxfp8
+            or ff._forward_hooks
+            or ff._forward_pre_hooks
+            or ff._backward_hooks
+            or hidden_states.requires_grad
+            or not hidden_states.is_cuda
+            or hidden_states.dtype != torch.bfloat16
+            or hidden_states.ndim != 3
+            or hidden_states.shape[0] != 1
+            or hidden_states.shape[1] < 1024
+            or hidden_states.shape[2] <= 0
+            or not hidden_states.is_contiguous()
+            or hidden_states.storage_offset() != 0
+            or torch.cuda.get_device_capability(hidden_states.device) != (10, 0)):
+        return None
+
+    with torch.cuda.device(hidden_states.device):
+        if torch.cuda.is_current_stream_capturing():
+            return None
+        current = torch.cuda.current_stream(hidden_states.device)
+        signature = _h3_ff_graph_signature(ff, hidden_states, current)
+        if signature is None:
+            return None
+
+        cache = getattr(_h3_ff_graph_forward, "_graphs_v2", None)
+        if cache is None:
+            import weakref
+            cache = weakref.WeakKeyDictionary()
+            _h3_ff_graph_forward._graphs_v2 = cache
+
+        state = cache.get(ff)
+        if state is None or state[0] != signature:
+            # Each layer owns its graph pool and stable input/output storage.
+            cache.pop(ff, None)
+            static_input = torch.empty_like(hidden_states)
+            side = torch.cuda.Stream(device=hidden_states.device)
+            side.wait_stream(current)
+            try:
+                with torch.cuda.stream(side):
+                    static_input.copy_(hidden_states)
+                    for _ in range(2):
+                        warm_output = ff._forward(static_input)
+                        del warm_output
+                side.synchronize()
+
+                signature = _h3_ff_graph_signature(ff, hidden_states, current)
+                if signature is None:
+                    return None
+
+                graph = torch.cuda.CUDAGraph()
+                with torch.cuda.graph(graph, stream=side):
+                    static_output = ff._forward(static_input)
+
+                after_capture = _h3_ff_graph_signature(ff, hidden_states, current)
+                if after_capture != signature:
+                    cache[ff] = (after_capture, None, None, None)
+                    return None
+            except (RuntimeError, torch.cuda.OutOfMemoryError):
+                cache[ff] = (signature, None, None, None)
+                return None
+            finally:
+                current.wait_stream(side)
+
+            state = (signature, graph, static_input, static_output)
+            cache[ff] = state
+
+        _, graph, static_input, static_output = state
+        if graph is None:
+            return None
+
+        # FFN projections are replicated, with no SP collective inside this
+        # graph. Every rank independently copies its current local shard.
+        static_input.copy_(hidden_states)
+        graph.replay()
+        # Preserve the original fresh-output ownership across later replays.
+        return static_output.clone(memory_format=torch.preserve_format)
+

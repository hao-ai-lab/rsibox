+def _h3_ff_graph_signature(ff, hidden_states, stream):
+    """Identify the frozen FFN state; reject unversioned weight tensors."""
+    tensors = []
+    options = []
+    for name, module in (("in", ff.fc_in), ("out", ff.fc_out)):
+        if (type(module) is not ReplicatedLinear
+                or module.training
+                or module.bias is not None
+                or module._forward_hooks
+                or module._forward_pre_hooks
+                or module._backward_hooks):
+            return None
+        method = module.quant_method
+        if type(method).__name__ != "NVFP4QuantizeMethod":
+            return None
+        packed = getattr(module, "_nvfp4_weight", None)
+        if (not isinstance(packed, torch.Tensor)
+                or packed.device != hidden_states.device):
+            return None
+
+        owners = (
+            ("module", vars(module)),
+            ("parameters", module._parameters),
+            ("buffers", module._buffers),
+            ("method", vars(method)),
+        )
+        for owner_name, values in owners:
+            for attr, value in sorted(values.items()):
+                label = (name, owner_name, attr)
+                if isinstance(value, torch.Tensor):
+                    try:
+                        version = value._version
+                    except RuntimeError:
+                        return None
+                    tensors.append((
+                        label, id(value), value.data_ptr(), version,
+                        tuple(value.shape), tuple(value.stride()),
+                        value.dtype, value.device,
+                    ))
+                elif type(value) in (bool, int, float, str, type(None)):
+                    options.append((label, value))
+        options.append((name, id(module), id(method), type(method)))
+
+    return (
+        tuple(hidden_states.shape),
+        tuple(hidden_states.stride()),
+        hidden_states.dtype,
+        hidden_states.device,
+        stream.cuda_stream,
+        torch.is_inference_mode_enabled(),
+        torch.is_autocast_enabled("cuda"),
+        torch.get_autocast_dtype("cuda"),
+        ff.fuse_swiglu,
+        ff.exact_swiglu,
+        ff.use_mxfp8,
+        type(ff)._forward,
+        tuple(tensors),
+        tuple(options),
+    )
+
